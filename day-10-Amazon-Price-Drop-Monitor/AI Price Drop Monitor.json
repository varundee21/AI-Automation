        "jsCode": "const html = $json.data;\n\nconst priceMatch = html.match(\n  /<span class=\"a-price-whole\">([\\d,]+)<\\/span>/\n);\n\nif (!priceMatch) {\n  return {\n    json: {\n      ...$('Edit Fields').item.json,\n      error: \"Price not found\"\n    }\n  };\n}\n\nconst currentPrice = Number(\n  priceMatch[1].replace(/,/g, '')\n);\n\nreturn {\n  json: {\n    product: $('Edit Fields').item.json.product,\n    url: $('Edit Fields').item.json.url,\n    target_price: Number($('Edit Fields').item.json.target_price),\n    current_price: currentPrice\n  }\n};"
      },
