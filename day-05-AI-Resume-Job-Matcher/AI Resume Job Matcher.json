      "credentials": {
        "googlePalmApi": {
          "id": "I8b7D68HbOlj6wGN",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $json.content.parts[0].text;\n\nconst result = JSON.parse(response);\n\nconst emailBody = `\nRESUME MATCH ANALYSIS\n\nMatch Score: ${result.match_score}/100\n\n✅ Matching Skills\n${result.matching_skills.map(skill => `• ${skill}`).join('\\n')}\n\n🟡 Partial Matches\n${result.partial_matches.map(skill => `• ${skill}`).join('\\n')}\n\n❌ Missing Skills\n${result.missing_skills.map(skill => `• ${skill}`).join('\\n')}\n\n💡 Recommendations\n${result.recommendations.map(item => `• ${item}`).join('\\n')}\n`;\n\nreturn [\n  {\n    json: {\n      match_score: result.match_score,\n      emailBody: emailBody\n    }\n  }\n];"
      },
