        "messages": {
          "values": [
            {
              "content": "=You are an AI job-matching assistant.\n\nCompare the candidate's resume against the job description.\n\nEvaluate the candidate based ONLY on information explicitly present in the resume and job description.\n\nReturn the result as JSON with exactly these fields:\n\n{\n  \"match_score\": 0,\n  \"matching_skills\": [],\n  \"partial_matches\": [],\n  \"missing_skills\": [],\n  \"recommendations\": []\n}\n\nScoring:\n90-100 = Excellent match\n75-89 = Strong match\n60-74 = Moderate match\n40-59 = Weak match\n0-39 = Poor match\n\nDo not invent skills or experience.\nDo not give credit for a skill unless the resume provides evidence.\n\nRESUME:\n{{ $json.text }}\n\nJOB DESCRIPTION:\n{{ $('On form submission').item.json['Job Description'] }}"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
